# URL ИИ-прокси (server/). Если задан, ключ Gemini в APK НЕ вшивается.
GRABBIT_AI_PROXY_URL=
# Ключ Gemini (только для dev-сборок без прокси) (бесплатно: https://aistudio.google.com/apikey).
# При сборке вшивается в приложение через app.config.ts → extra.geminiApiKey.
GEMINI_API_KEY=
# In-app updates use the public GitHub Releases API (no token needed).
# Optional alternative: a public JSON {"version":"1.2.0","apkUrl":"https://...apk","notes":"..."}
PINBOX_UPDATE_MANIFEST_URL=
