# Ключ Gemini (бесплатно: https://aistudio.google.com/apikey).
# При сборке вшивается в приложение через app.config.ts → extra.geminiApiKey.
GEMINI_API_KEY=
# Optional, for in-app updates (pick one):
# fine-grained token, ONLY "Contents: Read-only" on InM1nd/polka
PINBOX_UPDATE_TOKEN=
# or a public JSON {"version":"1.2.0","apkUrl":"https://...apk","notes":"..."}
PINBOX_UPDATE_MANIFEST_URL=
